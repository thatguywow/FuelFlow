{
  "name": "fuelflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first calorie & macro tracker. No server, no account, no AI dependency.",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc -b --noEmit",
    "device": "node tools/device.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "data:usda": "node scripts/fetch-usda.mjs",
    "data:core": "node scripts/build-core-db.mjs --usda=data-build/usda",
    "data:hosted": "node scripts/build-food-db.mjs --usda=data-build/usda",
    "data:all": "npm run data:usda && npm run data:core && npm run data:hosted",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor-mlkit/text-recognition": "^8.2.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-navigation-bar": "^8.2.6",
    "@zxing/browser": "^0.2.1",
    "capacitor-native-settings": "^8.2.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js-httpvfs": "^0.8.12",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "yaml": "^2.9.0"
  }
}
